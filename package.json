{
  "name": "ornitho2ebird",
  "version": "0.14.0",
  "homepage": "https://ornitho2ebird.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoziologie/ornitho2ebird.git"
  },
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "hotspots:calibrate": "node build/calibrate-hotspots.js",
    "splist": "node build/compile-species-list.js",
    "splist:check": "node build/check-species-list.js",
    "taxonomy:update": "node build/update-taxonomy.js",
    "taxonomy:test-file": "node build/make-matching-test.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "maplibre-gl": "^6.11.2",
    "papaparse": "^5.7.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "subset-font": "^2.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
